/* Vera terminal theme: 16/256-color safe semantic classes */

Screen {
    layout: vertical;
    overflow: hidden;
    scrollbar-size: 0 0;
    background: $background;
    color: $text;
    layers: base overlay modal;
}

#header {
    dock: top;
    width: 100%;
    height: auto;
    min-height: 1;
    background: $boost;
    color: $text-muted;
    padding: 0 2;
    overflow: hidden;
}

#header.-welcome {
    padding: 1 2;
}

#header-wordmark {
    color: $accent;
    text-style: bold;
    background: $boost;
}

#header.-welcome #header-wordmark {
    color: $logo;
    text-style: none;
}

#header-meta {
    background: $boost;
}

#work-rail {
    height: auto;
    padding: 0 2;
    color: $text-muted;
    background: $background;
}

#work-rail.-active {
    color: $text;
}

#welcome {
    dock: top;
    height: auto;
    background: $boost;
    color: $text-muted;
    padding: 0 2 1 2;
}

#user-sticky {
    width: auto;
    height: auto;
    margin: 0 2 0 2;
    background: $user-surface;
    border: none;
    padding: 1 1;
}

#timeline {
    height: 1fr;
    width: 100%;
    border: none;
    padding: 0;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-size-vertical: 0;
    scrollbar-size-horizontal: 0;
}

#timeline .run-outcome {
    width: 1fr;
    height: 1;
    margin: 0 3 1 3;
    color: $text-muted;
}

#timeline .run-outcome-done {
    color: $success;
}

#timeline .run-outcome-cancelled {
    color: $warning;
}

#timeline .run-outcome-failed {
    color: $error;
}

#completions {
    layer: overlay;
    dock: bottom;
    width: 100%;
    height: auto;
    max-height: 14;
    background: $boost;
    color: $text;
    padding: 0 2;
    margin-bottom: 5;
}

#skill-picker {
    layer: modal;
    dock: bottom;
    width: 100%;
    height: 50%;
    min-height: 8;
    max-height: 12;
    margin-bottom: 5;
    padding: 0 1;
    background: $boost;
    color: $text;
    border: solid $accent;
    scrollbar-size: 0 0;
}

#skill-picker-title {
    height: 1;
    color: $text;
    text-style: bold;
    padding: 0 1;
}

#skill-picker-options {
    height: 1fr;
    width: 100%;
    overflow-x: hidden;
    overflow-y: auto;
    background: $boost;
    color: $text;
    border: none;
    padding: 0 1;
    scrollbar-size-vertical: 0;
    scrollbar-size-horizontal: 0;
}

#skill-picker-options > .option-list--separator {
    color: $text-muted;
}

#skill-picker-message {
    height: 1;
    color: $warning;
    padding: 0 1;
}

#composer-bar {
    width: 100%;
    min-height: 3;
    margin: 0 2 1 2;
    background: $background;
    border: round $accent;
    padding: 0 1;
    overflow: hidden;
}

#composer-bar:focus-within {
    border: round $accent;
}

#composer {
    height: auto;
    min-height: 1;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent !important;
    scrollbar-size: 0 0;
    overflow-y: hidden;
    color: $text;
}

#composer .text-area--cursor-line {
    background: transparent;
}

#composer-prompt {
    width: 2;
    height: 1;
    color: $accent;
    padding: 0;
    background: transparent;
}

#status-line {
    dock: bottom;
    width: 100%;
    height: 1;
    background: $panel;
    color: $text-muted;
    padding: 0 2;
    overflow: hidden;
    text-wrap: nowrap;
}

UserBlockWidget {
    width: 1fr;
    background: $user-surface;
    border: none;
    margin: 1 2;
    padding: 1 1;
    color: $text !important;
}

UserBlockWidget .block-body {
    color: $text !important;
}

UserBlockWidget .block-time {
    color: $text-muted !important;
}

DiffBlockWidget .diff-add {
    color: $success;
}

DiffBlockWidget .diff-remove {
    color: $error;
}

DiffBlockWidget {
    height: auto;
}

#terminal-too-small {
    layer: overlay;
    width: 100%;
    height: 100%;
    content-align: center middle;
    background: $background;
    color: $warning;
    display: none;
}

.-narrow {
    /* secondary header fields collapsed via widget update */
}

.theme-high-contrast,
.theme-high-contrast #header,
.theme-high-contrast #welcome,
.theme-high-contrast #timeline,
.theme-high-contrast #completions,
.theme-high-contrast #composer-bar,
.theme-high-contrast #work-rail,
.theme-high-contrast #status-line,
.theme-high-contrast #terminal-too-small,
.-theme-high-contrast,
.-theme-high-contrast #header,
.-theme-high-contrast #welcome,
.-theme-high-contrast #timeline,
.-theme-high-contrast #completions,
.-theme-high-contrast #composer-bar,
.-theme-high-contrast #work-rail,
.-theme-high-contrast #status-line,
.-theme-high-contrast #terminal-too-small {
    background: #000000;
    color: #ffffff;
}

.theme-high-contrast #header-wordmark,
.-theme-high-contrast #header-wordmark {
    background: #000000;
    color: #ffff00;
}

.theme-high-contrast #header-meta,
.-theme-high-contrast #header-meta {
    background: #000000;
}

.theme-high-contrast #timeline,
.-theme-high-contrast #timeline {
    border: none;
    padding: 0;
    outline: none;
    scrollbar-background: #000000;
    scrollbar-color: #ffffff;
    scrollbar-color-hover: #ffff00;
    scrollbar-color-active: #ffff00;
}

.theme-default #composer-bar,
.theme-default #composer-bar:focus-within,
.-theme-default #composer-bar,
.-theme-default #composer-bar:focus-within {
    border: round $accent;
}

.theme-light,
.theme-light #header,
.theme-light #welcome,
.theme-light #timeline,
.theme-light #completions,
.theme-light #skill-picker,
.theme-light #composer-bar,
.theme-light #work-rail,
.theme-light #status-line,
.theme-light #terminal-too-small,
.-theme-light,
.-theme-light #header,
.-theme-light #welcome,
.-theme-light #timeline,
.-theme-light #completions,
.-theme-light #skill-picker,
.-theme-light #composer-bar,
.-theme-light #work-rail,
.-theme-light #status-line,
.-theme-light #terminal-too-small {
    background: #F3F6F9;
    color: #1A2B36;
}

.theme-light #header,
.-theme-light #header,
.theme-light #completions,
.-theme-light #completions,
.theme-light #skill-picker,
.-theme-light #skill-picker,
.theme-light #work-rail,
.-theme-light #work-rail,
.theme-light #status-line,
.-theme-light #status-line {
    background: #E7EEF3;
}

.theme-light #header-wordmark,
.-theme-light #header-wordmark {
    background: #E7EEF3;
    color: #2F6F82;
}

.theme-light #header-meta,
.-theme-light #header-meta {
    background: #E7EEF3;
    color: #5A7180;
}

.theme-light #timeline,
.-theme-light #timeline {
    background: #F3F6F9;
    border: none;
    outline: none;
}

.theme-light #composer-bar,
.theme-light #composer-bar:focus-within,
.-theme-light #composer-bar,
.-theme-light #composer-bar:focus-within {
    background: #FFFFFF;
    color: #1A2B36;
    border: solid #2F6F82;
}

.theme-light #composer,
.theme-light #composer:focus,
.-theme-light #composer,
.-theme-light #composer:focus,
.theme-light #composer-prompt,
.-theme-light #composer-prompt {
    background: transparent;
    color: #1A2B36;
}

.theme-light #user-sticky,
.-theme-light #user-sticky,
.theme-light UserBlockWidget,
.-theme-light UserBlockWidget {
    background: $user-surface;
    color: #1A2B36;
    border: none;
}

.theme-light #skill-picker,
.-theme-light #skill-picker {
    border: solid #2F6F82;
}

.theme-light #skill-picker-options,
.-theme-light #skill-picker-options {
    background: #E7EEF3;
    color: #1A2B36;
}

.theme-cream,
.theme-cream #header,
.theme-cream #welcome,
.theme-cream #timeline,
.theme-cream #completions,
.theme-cream #skill-picker,
.theme-cream #composer-bar,
.theme-cream #work-rail,
.theme-cream #status-line,
.theme-cream #terminal-too-small,
.-theme-cream,
.-theme-cream #header,
.-theme-cream #welcome,
.-theme-cream #timeline,
.-theme-cream #completions,
.-theme-cream #skill-picker,
.-theme-cream #composer-bar,
.-theme-cream #work-rail,
.-theme-cream #status-line,
.-theme-cream #terminal-too-small {
    background: #FBF6EC;
    color: #3D3429;
}

.theme-cream #header,
.-theme-cream #header,
.theme-cream #completions,
.-theme-cream #completions,
.theme-cream #skill-picker,
.-theme-cream #skill-picker,
.theme-cream #work-rail,
.-theme-cream #work-rail,
.theme-cream #status-line,
.-theme-cream #status-line {
    background: #F3E8D4;
}

.theme-cream #header-wordmark,
.-theme-cream #header-wordmark {
    background: #F3E8D4;
    color: #C4843A;
}

.theme-cream #header-meta,
.-theme-cream #header-meta {
    background: #F3E8D4;
    color: #7A6E5F;
}

.theme-cream #timeline,
.-theme-cream #timeline {
    background: #FBF6EC;
    border: none;
    outline: none;
}

.theme-cream #composer-bar,
.theme-cream #composer-bar:focus-within,
.-theme-cream #composer-bar,
.-theme-cream #composer-bar:focus-within {
    background: #FFFCF5;
    color: #3D3429;
    border: solid #C4843A;
}

.theme-cream #composer,
.theme-cream #composer:focus,
.-theme-cream #composer,
.-theme-cream #composer:focus,
.theme-cream #composer-prompt,
.-theme-cream #composer-prompt {
    background: transparent;
    color: #3D3429;
}

.theme-cream #user-sticky,
.-theme-cream #user-sticky,
.theme-cream UserBlockWidget,
.-theme-cream UserBlockWidget {
    background: $user-surface;
    color: #3D3429;
    border: none;
}

.theme-high-contrast UserBlockWidget,
.-theme-high-contrast UserBlockWidget,
.theme-high-contrast UserBlockWidget .block-body,
.-theme-high-contrast UserBlockWidget .block-body,
.theme-high-contrast UserBlockWidget .user-prompt,
.-theme-high-contrast UserBlockWidget .user-prompt,
.theme-high-contrast UserBlockWidget .block-time,
.-theme-high-contrast UserBlockWidget .block-time,
.theme-high-contrast #user-sticky,
.-theme-high-contrast #user-sticky,
.theme-high-contrast #user-sticky-prompt,
.-theme-high-contrast #user-sticky-prompt,
.theme-high-contrast #user-sticky-body,
.-theme-high-contrast #user-sticky-body,
.theme-high-contrast #user-sticky-time,
.-theme-high-contrast #user-sticky-time {
    color: $background !important;
}

.theme-cream #skill-picker,
.-theme-cream #skill-picker {
    border: solid #C4843A;
}

.theme-cream #skill-picker-options,
.-theme-cream #skill-picker-options {
    background: #F3E8D4;
    color: #3D3429;
}

.theme-high-contrast #composer-bar,
.theme-high-contrast #composer-bar:focus-within,
.-theme-high-contrast #composer-bar,
.-theme-high-contrast #composer-bar:focus-within {
    background: #000000;
    color: #ffffff;
    border: round #ffff00;
}

.theme-high-contrast #composer,
.theme-high-contrast #composer:focus,
.-theme-high-contrast #composer,
.-theme-high-contrast #composer:focus,
.theme-high-contrast #composer-prompt,
.-theme-high-contrast #composer-prompt {
    background: transparent;
    color: #ffff00;
}

.theme-high-contrast #user-sticky,
.-theme-high-contrast #user-sticky,
.theme-high-contrast UserBlockWidget,
.-theme-high-contrast UserBlockWidget {
    background: $user-surface;
    color: $background;
    border: none;
}

.theme-no-color,
.theme-no-color #header,
.theme-no-color #welcome,
.theme-no-color #completions,
.theme-no-color #work-rail,
.theme-no-color #status-line,
.-theme-no-color,
.-theme-no-color #header,
.-theme-no-color #completions,
.-theme-no-color #work-rail,
.-theme-no-color #status-line {
    background: #222222;
    color: #e0e0e0;
}

.theme-no-color #user-sticky,
.-theme-no-color #user-sticky,
.theme-no-color UserBlockWidget,
.-theme-no-color UserBlockWidget {
    background: $user-surface;
    color: #f5f5f5 !important;
    border: none;
}

.theme-no-color UserBlockWidget .block-body,
.-theme-no-color UserBlockWidget .block-body {
    color: #f5f5f5 !important;
}

.theme-no-color #timeline,
.-theme-no-color #timeline {
    background: #1a1a1a;
    color: #e0e0e0;
    border: none;
    scrollbar-background: #1a1a1a;
    scrollbar-color: #888888;
    scrollbar-color-hover: #b0b0b0;
    scrollbar-color-active: #b0b0b0;
}

.theme-no-color #composer-bar,
.theme-no-color #composer-bar:focus-within,
.-theme-no-color #composer-bar,
.-theme-no-color #composer-bar:focus-within {
    background: #1a1a1a;
    color: #e0e0e0;
    border: round #B0B0B0;
}

.theme-no-color #composer,
.theme-no-color #composer:focus,
.-theme-no-color #composer,
.-theme-no-color #composer:focus,
.theme-no-color #composer-prompt,
.-theme-no-color #composer-prompt {
    background: transparent;
    color: #e0e0e0;
}
