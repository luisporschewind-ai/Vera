/* Vera terminal theme: 16/256-color safe semantic classes */

Screen {
    layout: vertical;
    overflow: hidden;
    scrollbar-size: 0 0;
    background: $background;
    color: $text;
}

#header {
    dock: top;
    height: auto;
    min-height: 1;
    background: $boost;
    color: $text-muted;
    padding: 0 2;
}

#header-wordmark {
    color: $accent;
    text-style: bold;
}

#work-rail {
    height: auto;
    padding: 0 2;
    color: $text-muted;
    background: $background;
}

#work-rail.-active {
    color: $text;
}

#welcome {
    dock: top;
    height: auto;
    background: $boost;
    color: $text-muted;
    padding: 0 2 1 2;
}

#user-sticky {
    width: auto;
    height: auto;
    margin: 0 2 0 2;
    background: $secondary;
    border: none;
    padding: 1 1;
}

#timeline {
    height: 1fr;
    width: 100%;
    border: none;
    padding: 0;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-size-vertical: 0;
    scrollbar-size-horizontal: 0;
}

#completions {
    layer: overlay;
    dock: bottom;
    width: 100%;
    height: auto;
    max-height: 14;
    background: $boost;
    color: $text;
    padding: 0 2;
    margin-bottom: 5;
}

#composer-bar {
    min-height: 3;
    margin: 0 2 1 2;
    background: transparent;
    border: round $accent;
    padding: 0 1;
}

#composer-bar:focus-within {
    border: round $accent;
}

#composer {
    height: auto;
    min-height: 1;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent !important;
    scrollbar-size: 0 0;
    overflow-y: hidden;
    color: $text;
}

#composer .text-area--cursor-line {
    background: transparent;
}

#composer-prompt {
    width: 2;
    height: 1;
    color: $accent;
    padding: 0;
    background: transparent;
}

#status-line {
    dock: bottom;
    height: 1;
    background: $panel;
    color: $text-muted;
    padding: 0 2;
}

UserBlockWidget {
    width: 1fr;
    background: $secondary;
    border: none;
    margin: 1 2;
    padding: 1 1;
    color: $text !important;
}

UserBlockWidget .block-body {
    color: $text !important;
}

UserBlockWidget .block-time {
    color: $text-muted !important;
}

DiffBlockWidget .diff-add {
    color: $success;
}

DiffBlockWidget .diff-remove {
    color: $error;
}

DiffBlockWidget {
    height: auto;
}

#terminal-too-small {
    layer: overlay;
    width: 100%;
    height: 100%;
    content-align: center middle;
    background: $background;
    color: $warning;
    display: none;
}

.-narrow {
    /* secondary header fields collapsed via widget update */
}

.theme-high-contrast,
.theme-high-contrast #header,
.theme-high-contrast #welcome,
.theme-high-contrast #timeline,
.theme-high-contrast #completions,
.theme-high-contrast #composer-bar,
.theme-high-contrast #work-rail,
.theme-high-contrast #status-line,
.theme-high-contrast #terminal-too-small,
.-theme-high-contrast,
.-theme-high-contrast #header,
.-theme-high-contrast #welcome,
.-theme-high-contrast #timeline,
.-theme-high-contrast #completions,
.-theme-high-contrast #composer-bar,
.-theme-high-contrast #work-rail,
.-theme-high-contrast #status-line,
.-theme-high-contrast #terminal-too-small {
    background: #000000;
    color: #ffffff;
}

.theme-high-contrast #header-wordmark,
.-theme-high-contrast #header-wordmark {
    color: #ffff00;
}

.theme-high-contrast #timeline,
.-theme-high-contrast #timeline {
    border: none;
    padding: 0;
    outline: none;
    scrollbar-background: #000000;
    scrollbar-color: #ffffff;
    scrollbar-color-hover: #ffff00;
    scrollbar-color-active: #ffff00;
}

.theme-default #composer-bar,
.theme-default #composer-bar:focus-within,
.-theme-default #composer-bar,
.-theme-default #composer-bar:focus-within {
    border: round $accent;
}

.theme-high-contrast #composer-bar,
.theme-high-contrast #composer-bar:focus-within,
.-theme-high-contrast #composer-bar,
.-theme-high-contrast #composer-bar:focus-within {
    background: #000000;
    color: #ffffff;
    border: round #ffff00;
}

.theme-high-contrast #composer,
.theme-high-contrast #composer:focus,
.-theme-high-contrast #composer,
.-theme-high-contrast #composer:focus,
.theme-high-contrast #composer-prompt,
.-theme-high-contrast #composer-prompt {
    background: transparent;
    color: #ffff00;
}

.theme-high-contrast #user-sticky,
.-theme-high-contrast #user-sticky,
.theme-high-contrast UserBlockWidget,
.-theme-high-contrast UserBlockWidget {
    background: #000000;
    color: #ffffff;
    border: none;
}

.theme-no-color,
.theme-no-color #header,
.theme-no-color #welcome,
.theme-no-color #completions,
.theme-no-color #work-rail,
.theme-no-color #status-line,
.-theme-no-color,
.-theme-no-color #header,
.-theme-no-color #completions,
.-theme-no-color #work-rail,
.-theme-no-color #status-line {
    background: #222222;
    color: #e0e0e0;
}

.theme-no-color #user-sticky,
.-theme-no-color #user-sticky,
.theme-no-color UserBlockWidget,
.-theme-no-color UserBlockWidget {
    background: #222222;
    color: #f5f5f5 !important;
    border: none;
}

.theme-no-color UserBlockWidget .block-body,
.-theme-no-color UserBlockWidget .block-body {
    color: #f5f5f5 !important;
}

.theme-no-color #timeline,
.-theme-no-color #timeline {
    background: #1a1a1a;
    color: #e0e0e0;
    border: none;
    scrollbar-background: #1a1a1a;
    scrollbar-color: #888888;
    scrollbar-color-hover: #b0b0b0;
    scrollbar-color-active: #b0b0b0;
}

.theme-no-color #composer-bar,
.theme-no-color #composer-bar:focus-within,
.-theme-no-color #composer-bar,
.-theme-no-color #composer-bar:focus-within {
    background: #1a1a1a;
    color: #e0e0e0;
    border: round #B0B0B0;
}

.theme-no-color #composer,
.theme-no-color #composer:focus,
.-theme-no-color #composer,
.-theme-no-color #composer:focus,
.theme-no-color #composer-prompt,
.-theme-no-color #composer-prompt {
    background: transparent;
    color: #e0e0e0;
}
